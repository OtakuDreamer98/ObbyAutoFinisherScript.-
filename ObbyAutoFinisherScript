-- Auto-fill path
local function isValidPath(pathStr)
	local success, result = pcall(function()
		return loadstring("return " .. pathStr)()
	end)

	if success and (typeof(result) == "Instance" or typeof(result) == "table") then
		return true, pathStr
	end

	return false, nil
end

local function trySetPath(index)
	local pathStr = SavedPaths[index]
	local isValid, path = isValidPath(pathStr)

	if isValid then
		PathInput.Text = path
		currentPathIndex = index
		currentPath = path
		setStatus("Auto-filled path: " .. path, Color3.fromRGB(0, 255, 150))
		return true
	end

	return false
end

task.spawn(function()
	local found = false
	for i = 1, #SavedPaths do
		if trySetPath(i) then
			found = true
			break
		end
	end
	if not found then
		currentPath = SavedPaths[1] -- fallback to first even if invalid
		currentPathIndex = 1
		PathInput.Text = currentPath
		setStatus("No valid saved path found, defaulting", Color3.fromRGB(255, 180, 0))
	end
end)

