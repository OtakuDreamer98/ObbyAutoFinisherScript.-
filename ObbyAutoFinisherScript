-- TELEPORT LOOP
local function teleportLoop()
	teleporting = true
	MainFrame:SetAttribute("Teleporting", true)
	setStatus("Teleporting...", Color3.fromRGB(0, 255, 0))
	StartButton.AutoButtonColor = false
	StartButton.BackgroundTransparency = 0.4

	local delayTime = tonumber(DelayInput.Text) or 1
	local startStage = tonumber(StartStageInput.Text) or 1

	local function getSortedStages(container)
		local children = container:GetChildren()
		table.sort(children, function(a, b)
			local aNum = tonumber(a.Name:match("%d+"))
			local bNum = tonumber(b.Name:match("%d+"))
			return (aNum or math.huge) < (bNum or math.huge)
		end)
		return children
	end

	if UseAdvancedCheckpoint.Value then
		local stagesFolder = workspace:FindFirstChild("Stages")
		if not stagesFolder then
			setStatus("Stages folder not found", Color3.fromRGB(255, 100, 100))
			return
		end

		local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
		if not character.PrimaryPart then
			character:GetPropertyChangedSignal("PrimaryPart"):Wait()
		end

		local stages = getSortedStages(stagesFolder)
		for i = startStage, #stages do
			if not teleporting then break end
			local stage = stages[i]
			local checkpoint = stage:FindFirstChild("Checkpoint") and stage.Checkpoint:FindFirstChild("Checkpoint")
			if checkpoint then
				character:SetPrimaryPartCFrame(checkpoint.CFrame)
				setStatus("Teleported to " .. stage.Name, Color3.fromRGB(0, 255, 255))
			else
				setStatus("Checkpoint missing in " .. stage.Name, Color3.fromRGB(255, 100, 100))
			end
			task.wait(delayTime)
		end
	else
		local success, result = pcall(function()
			return loadstring("return " .. PathInput.Text)()
		end)

		if not success or (typeof(result) ~= "Instance" and typeof(result) ~= "table") then
			setStatus("Invalid path input", Color3.fromRGB(255, 100, 100))
			PathInput.BackgroundColor3 = Color3.fromRGB(120, 30, 30)
			teleporting = false
			MainFrame:SetAttribute("Teleporting", false)
			StartButton.BackgroundTransparency = 0
			StartButton.AutoButtonColor = true
			return
		end

		PathInput.BackgroundColor3 = Color3.fromRGB(70, 70, 70)
		local stages = typeof(result) == "table" and result or getSortedStages(result)
		setStatus("Found " .. tostring(#stages) .. " stages", Color3.fromRGB(0, 200, 255))

		local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()

		for i = startStage, #stages do
			if not teleporting then break end
			local stage = stages[i]
			if stage and character then
				local hrp = character:FindFirstChild("HumanoidRootPart")
				local tpPart = stage:FindFirstChild("Spawn") or stage:FindFirstChild("Checkpoint") or stage
				if hrp and tpPart and tpPart:IsA("BasePart") then
					hrp.CFrame = tpPart.CFrame + Vector3.new(0, 10, 0)
					setStatus("Teleported to " .. stage.Name, Color3.fromRGB(0, 255, 255))
				else
					setStatus("Teleport part not found in " .. stage.Name, Color3.fromRGB(255, 100, 100))
					break
				end
			else
				setStatus("Stage not found at index " .. tostring(i), Color3.fromRGB(255, 100, 100))
				break
			end
			task.wait(delayTime)
		end
	end

	teleporting = false
	MainFrame:SetAttribute("Teleporting", false)
	setStatus("Stopped", Color3.fromRGB(255, 255, 0))
	StartButton.BackgroundTransparency = 0
	StartButton.AutoButtonColor = true
end

